---
// Channel picker: real links only (tel, messengers, Instagram). Popover on wide screens, bottom sheet on phones.
// Opened by any <button popovertarget="channels">; Esc, the close button and a tap outside close it, focus returns.
import Icon from "./Icon.astro";
import { channels, email } from "../data/site";
---
<div id="channels" class="channels" popover role="dialog" aria-labelledby="channels-title" data-rec="UX-R-2">
  <div class="channels__head">
    <p id="channels-title" class="channels__title">Як зручніше зв’язатися?</p>
    <button class="icon-btn" type="button" popovertarget="channels" popovertargetaction="hide" aria-label="Закрити"><Icon name="close" /></button>
  </div>
  <ul class="channels__list" data-rec="SPD-R005,S-R012">
    {channels.map((c) => (
      <li>
        <a href={c.href} {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
          <span class="channels__icon"><Icon name={c.icon} /></span>
          <span class="channels__text"><strong>{c.label}</strong><span class="num">{c.note}</span></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="channels__note">Записуємо Пн–Сб з 9:00 до 21:00. Пошта для нетермінових питань: <a class="link" href={email.href}>{email.label}</a></p>
</div>

<style>
  .channels {
    margin: 0; padding: var(--space-3); border: 0;
    background: var(--color-bg); color: var(--color-text);
    box-shadow: 0 24px 64px var(--color-shadow);
    position: fixed; inset: auto 0 0 0; width: 100%; max-width: none; max-height: 90dvh; overflow-y: auto;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  }
  .channels::backdrop { background: var(--color-scrim); }
  @media (min-width: 768px) {
    .channels {
      inset: var(--channels-top, calc(var(--header-h) + 12px)) auto auto var(--channels-left, auto);
      right: var(--channels-right, var(--gutter));
      width: 380px; border-radius: var(--radius-panel);
      padding-bottom: var(--space-3);
    }
    .channels::backdrop { background: transparent; }
  }
  .channels__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-2); }
  .channels__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 700; letter-spacing: -0.01em; }
  .channels__list { display: grid; gap: 2px; }
  .channels__list a {
    display: flex; align-items: center; gap: var(--space-2); min-height: 56px; padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-panel); text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .channels__list a:hover { background: var(--color-surface); }
  .channels__icon { display: grid; place-items: center; width: 24px; flex: none; color: var(--color-primary); }
  .channels__icon :global(svg) { width: 24px; height: 24px; }
  .channels__text { display: grid; line-height: 1.25; }
  .channels__text strong { font-weight: 600; }
  .channels__text span { color: var(--color-text-muted); font-size: var(--fs-small); font-family: var(--font-body); }
  .channels__note { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--color-text-muted); }

  /* Motion 4: sheet slides up on phones, popover fades and scales on wide screens. */
  @media (prefers-reduced-motion: no-preference) {
    .channels:popover-open { animation: ch-sheet 280ms var(--ease-out); }
    @media (min-width: 768px) { .channels:popover-open { animation: ch-pop 220ms var(--ease-out); } }
  }
  @keyframes ch-sheet { from { transform: translateY(100%); } to { transform: none; } }
  @keyframes ch-pop { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
</style>
