---
// Phone-only bottom bar after the hero (replaces four floating circles — UX-R-6).
import Icon from "./Icon.astro";
import { phones } from "../data/site";
---
<div class="mobile-bar" data-mobile-bar data-rec="UX-R-6">
  <a class="mobile-bar__btn mobile-bar__btn--call" href={phones.main.href}><Icon name="phone" />Подзвонити</a>
  <button class="mobile-bar__btn" type="button" popovertarget="channels"><Icon name="message" />Написати</button>
</div>
<style>
  .mobile-bar { display: none; }
  @media (max-width: 767.98px) {
    :global(body) { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
    .mobile-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 35;
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-1);
      padding: var(--space-1) var(--gutter) calc(var(--space-1) + env(safe-area-inset-bottom));
      background: var(--color-bg); border-top: 1px solid var(--color-border);
      transition: transform var(--dur-ui) var(--ease-out);
    }
    :global(.js) .mobile-bar:not(.is-shown) { transform: translateY(110%); }
  }
  .mobile-bar__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 52px;
    border: 2px solid var(--color-primary); border-radius: var(--radius);
    background: var(--color-bg); color: var(--color-primary);
    font: 600 var(--fs-body) / 1 var(--font-body); text-decoration: none; cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .mobile-bar__btn:hover { background: var(--color-surface); }
  .mobile-bar__btn--call { background: var(--color-primary); color: var(--color-on-primary); }
  .mobile-bar__btn--call:hover { background: var(--color-primary-hover); }
  .mobile-bar__btn:active { transform: scale(.98); }
  .mobile-bar__btn :global(svg) { width: 20px; height: 20px; }
</style>
